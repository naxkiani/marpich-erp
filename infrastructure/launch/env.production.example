# Production-profile placeholders only. NEVER commit real values.
# Copy to a gitignored file. Inject via Docker secrets / Kubernetes ExternalSecrets / cloud SM.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=marpich_platform
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
DOCUMENT_SIGNING_SECRET=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@CHANGE_ME_HOST:5432/marpich_platform
REDIS_URL=redis://CHANGE_ME_HOST:6379
MARPICH_ENVIRONMENT=production
PERSISTENCE_BACKEND=postgres
EVENT_BUS_MODE=outbox
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE_ME_OTLP:4318
MEOS_DOMAIN=CHANGE_ME_HOSTNAME
# Immutable artifact (digest form). Never :latest for certification.
# Example when CI/GHCR exists: ghcr.io/marpich/marpich-backend@sha256:<digest>
MEOS_IMAGE=
MEOS_IMAGE_DIGEST=NOT_AVAILABLE
MEOS_PREVIOUS_IMAGE=
