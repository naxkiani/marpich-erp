# Marpich / MEOS — safe placeholders only. NEVER commit real secrets.
# LOCAL and DEVELOPMENT are NOT PRODUCTION.
# Canonical backend template: backend/.env.example
# Local Postgres is typically host port 5433 (compose.dev), not 5432.

# Platform
NODE_ENV=development
PLATFORM_NAME=Marpich ERP
PLATFORM_VERSION=0.1.0
MARPICH_ENVIRONMENT=development

# PostgreSQL (LOCAL / NON_PRODUCTION)
DATABASE_URL=postgresql://marpich:marpich@127.0.0.1:5433/marpich_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Kafka / Event Bus
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_BROKERS=127.0.0.1:9092
EVENT_BUS_DRIVER=kafka

# Multi-tenant
TENANT_RESOLUTION_STRATEGY=subdomain
DEFAULT_TENANT_SCHEMA=public

# JWT (production: non-default secret ≥ 32 chars — never commit the production value)
JWT_SECRET=change-me-in-production-use-256-bit-key
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Optional AI — leave empty; never commit a real key
AI_PROVIDER=openai
OPENAI_API_KEY=
