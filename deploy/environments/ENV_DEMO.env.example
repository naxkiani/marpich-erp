# ENV_DEMO — COMPOSE_IS_PRODUCTION=FALSE
APP_ENV=demo
DATABASE_URL=CHANGE_ME_DEMO_POSTGRES
DATABASE_SSL=disable
REDIS_URL=CHANGE_ME_DEMO_REDIS
SECRET_PROVIDER=env_file
STORAGE_PROVIDER=minio
PUBLIC_BASE_URL=http://127.0.0.1:8080
TLS_MODE=none_on_8080_self_signed_caddy_8443_NON_PRODUCTION
EMAIL_PROVIDER=none
OBSERVABILITY_PROVIDER=otlp_optional
BACKUP_PROVIDER=scripts/meos-postgres-backup.sh
REGISTRY=local
IMAGE=meos/backend:local-build
IMAGE_DIGEST=NOT_AVAILABLE
DEPLOYMENT_METHOD=infrastructure/docker/compose/docker-compose.meos-prod.yml
PROFILE_CLASS=DEMO_NON_PRODUCTION
