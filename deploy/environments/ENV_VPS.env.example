# ENV_VPS — READY_FOR_CREDENTIALS
APP_ENV=vps
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@CHANGE_ME_HOST:5432/marpich_platform
DATABASE_SSL=require
REDIS_URL=redis://CHANGE_ME_HOST:6379
SECRET_PROVIDER=env_file
STORAGE_PROVIDER=CHANGE_ME
PUBLIC_BASE_URL=https://CHANGE_ME_HOSTNAME
TLS_MODE=public_ca
EMAIL_PROVIDER=CHANGE_ME
OBSERVABILITY_PROVIDER=otlp
BACKUP_PROVIDER=scripts/meos-postgres-backup.sh
REGISTRY=ghcr.io/marpich/marpich-backend
IMAGE=ghcr.io/marpich/marpich-backend
IMAGE_DIGEST=NOT_AVAILABLE
DEPLOYMENT_METHOD=scripts/meos-vps-bootstrap.sh
PROFILE_CLASS=READY_FOR_CREDENTIALS
