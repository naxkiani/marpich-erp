# ENV_AZURE — VM+Compose. AKS uses ENV_KUBERNETES.
APP_ENV=azure
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@CHANGE_ME_PG:5432/marpich_platform
DATABASE_SSL=require
REDIS_URL=redis://CHANGE_ME_HOST:6379
SECRET_PROVIDER=azure_key_vault
STORAGE_PROVIDER=blob
PUBLIC_BASE_URL=https://CHANGE_ME_HOSTNAME
TLS_MODE=public_ca
EMAIL_PROVIDER=CHANGE_ME
OBSERVABILITY_PROVIDER=otlp
BACKUP_PROVIDER=azure_backup_or_script
REGISTRY=ghcr.io/marpich/marpich-backend
IMAGE=ghcr.io/marpich/marpich-backend
IMAGE_DIGEST=NOT_AVAILABLE
DEPLOYMENT_METHOD=azure_vm_docker_compose
PROFILE_CLASS=READY_FOR_CREDENTIALS
