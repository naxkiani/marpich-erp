# ENV_LOCAL — NON_PRODUCTION. Placeholders only.
APP_ENV=local
DATABASE_URL=postgresql://marpich:marpich@127.0.0.1:5433/marpich_platform
DATABASE_SSL=disable
REDIS_URL=redis://127.0.0.1:6379
SECRET_PROVIDER=env_file
STORAGE_PROVIDER=local_or_minio
PUBLIC_BASE_URL=http://127.0.0.1:8000
TLS_MODE=none
EMAIL_PROVIDER=none
OBSERVABILITY_PROVIDER=otlp_optional
BACKUP_PROVIDER=scripts/meos-postgres-backup.sh
REGISTRY=none
IMAGE=not_required_for_uvicorn
IMAGE_DIGEST=NOT_AVAILABLE
DEPLOYMENT_METHOD=scripts/dev-up.sh
PROFILE_CLASS=NON_PRODUCTION
