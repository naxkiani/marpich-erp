  "properties": {
    "admission_id": { "type": "string", "format": "uuid" },
    "patient_id": { "type": "string", "format": "uuid" },
    "from_ward": { "type": "string", "minLength": 1 },
    "to_ward": { "type": "string", "minLength": 1 },
    "from_bed_id": { "type": ["string", "null"], "format": "uuid" },
    "to_bed_id": { "type": ["string", "null"], "format": "uuid" }
  },
  "additionalProperties": false
}
